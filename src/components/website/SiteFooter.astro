---
// The website footer (every page). Columns, links and words: src/data/site.json.
import site from "../../data/site.json";
import { link } from "../../lib/website";
import lockupRaw from "../../assets/brand/lockup.svg?raw";

const lockup = lockupRaw.trim().replace('fill="#1D1D1F"', 'fill="currentColor"').replace("<svg ", '<svg aria-hidden="true" ');
const f = site.footer;
---
<footer class="site-foot"><div class="site-wrap">
<div class="site-foot-top"><div class="site-foot-brand"><Fragment set:html={lockup} /><p>{f.tag}<span class="hd-dot">.</span></p></div>
<div class="site-foot-cols">
  {f.columns.map((c) => (
    <div><h4>{c.title}</h4><ul>{c.links.map((l) => <li><a href={link(l.href)}>{l.label}</a></li>)}</ul></div>
  ))}
</div></div>
<div class="site-foot-fine"><span>{f.copyright}</span><span>{f.fine}</span></div></div></footer>
