---
// Layout for the pages that are still built with Tailwind (about, contact, 404, the two earlier blog posts).
// Same header, footer, tokens and glass as the new website (SiteLayout); see docs/website/README.md.
import SiteLayout from "./SiteLayout.astro";
import "../styles/website/site-page.css";
import "../styles/legacy.css";

export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const makeTitle = title ? `${title} · Aero` : "Aero";
const desc = description || "Aero puts what you made online at its own address and gives you one link to test it with people. Free to start.";
---
<SiteLayout title={makeTitle} description={desc} bodyClass="site s-page legacy-page" script="none" noindex={noindex}>
  <slot />
</SiteLayout>
