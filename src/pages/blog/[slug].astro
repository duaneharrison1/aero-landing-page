---
// Blog posts.
// - New posts (Oct 2026 design): one entry in src/data/blog.json, words in src/data/copy/blog/<slug>.json, body in
//   src/markup/blog/<slug>.html. Older / Newer links are built from blog.json.
// - The two earlier posts in src/content/blog (Markdown) still render at their old addresses.
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/container.astro";
import "../../styles/website/site-page.css";
import { getPage } from "../../lib/website";
import posts from "../../data/blog.json";

export async function getStaticPaths() {
  const sorted = [...posts].sort((a, b) => a.date.localeCompare(b.date));
  const fresh = sorted.map((p, i) => ({
    params: { slug: p.slug },
    props: { kind: "new", slug: p.slug, older: sorted[i - 1] || null, newer: sorted[i + 1] || null },
  }));
  const taken = new Set(posts.map((p) => p.slug));
  const old = (await getCollection("blog"))
    .filter((e) => !taken.has(e.slug))
    .map((entry) => ({ params: { slug: entry.slug }, props: { kind: "old", entry } }));
  return [...fresh, ...old];
}

const props = Astro.props as any;
let page: ReturnType<typeof getPage> | null = null;
let body = "";
let Content: any = null;
if (props.kind === "new") {
  page = getPage(`blog/${props.slug}`);
  const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  const c = page.copy as Record<string, string>;
  const a = (p: { slug: string; title: string } | null, label: string, cls = "") =>
    p ? `<a${cls ? ` class="${cls}"` : ""} href="/blog/${p.slug}"><span class="site-eyebrow">${esc(label)}</span><b>${esc(p.title)}</b></a>` : "<span></span>";
  body = page.html.replace("<!--prev-next-->", `<nav class="s-pn">${a(props.older, c.prev || "Older")}${a(props.newer, c.next || "Newer", "r")}</nav>`);
} else {
  Content = (await props.entry.render()).Content;
}
---
{page ? (
  <SiteLayout title={page.meta.title} description={page.meta.description} bodyClass={page.meta.bodyClass} jsonld={page.meta.jsonld} copy={page.copy} script="site">
    <Fragment set:html={body} />
  </SiteLayout>
) : (
  <Layout title={props.entry.data.title}>
    <Container>
      <div class="prose prose-lg mx-auto mt-14 max-w-3xl">
        <Content />
      </div>
    </Container>
  </Layout>
)}
