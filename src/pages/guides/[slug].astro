---
// Task guides: one template, data in src/data/guides.json. See docs/website/README.md, "Guides".
// publish-a-claude-artifact keeps its own hand-built page (src/pages/guides/publish-a-claude-artifact.astro),
// which Astro picks over this route, so it is skipped here.
import SiteLayout from "../../layouts/SiteLayout.astro";
import "../../styles/website/site-page.css";
import { GUIDES, bySlug, cardHtml, jsonLd, esc, ICON, PILL } from "../../lib/guides";
import { link } from "../../lib/website";
import { guidePicHtml, stepPic } from "../../lib/guide-images";

export function getStaticPaths() {
  return GUIDES.filter((g) => !g.existing).map((g) => ({ params: { slug: g.slug }, props: { slug: g.slug } }));
}
const g = bySlug(Astro.props.slug)!;
const related = (g.related || []).map(bySlug).filter(Boolean);
const next = g.next ? bySlug(g.next.slug) : null;
const signup = link("@signup");
---
<SiteLayout title={g.metaTitle!} description={g.description!} bodyClass="site s-page" jsonld={jsonLd(g)} script="site">
  <section class="s-hero s-task-hero"><div class="site-wrap s-narrow">
    <nav class="s-crumb" aria-label="Breadcrumb"><a href="/guides">Guides</a><svg class="i" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 3 5 5-5 5"/></svg><span aria-current="page">{g.title}</span></nav>
    <Fragment set:html={PILL[g.group]} /><h1 class="site-h1 s-h1-task">{g.title}<span class="hd-dot">.</span></h1>
    <p class="site-lead s-answer">{g.answer}</p>
    <p class="s-fine-row">{g.facts!.map((f) => <span><Fragment set:html={ICON.tick} />{f}</span>)}</p>
  </div></section>
  <section><div class="site-wrap s-narrow">
    <div class="s-need"><h2 class="site-h3">What you need</h2><ul>{g.needs!.map((n) => <li><Fragment set:html={ICON.tick} />{n}</li>)}</ul></div>
    <h2 class="site-h2 s-h2">Steps</h2>
    <ol class="s-steps s-steps-text">{g.steps!.map((s, i) => { const pic = stepPic(g.slug, i + 1); return <li class="s-step"><div class="s-step-tx"><span class="s-step-n">{i + 1}</span><div><h3 class="site-h3">{s.name}</h3><p class="site-body">{s.text}</p></div></div>{pic && <Fragment set:html={guidePicHtml(pic, g.group)} />}</li>; })}</ol>
    <div class="s-need s-gets"><h2 class="site-h3">What you get</h2><ul>{g.gets!.map((n) => <li><Fragment set:html={ICON.tick} />{n}</li>)}</ul></div>
    {g.alt && <div class="s-alt"><h3 class="site-h3">{g.alt.h}</h3><p class="site-body">{g.alt.p}</p></div>}
    {g.group === "publish" && next ? (
      <div class="site-band w-test s-next"><div><Fragment set:html={PILL.test} /><h2 class="site-h2">Then test it<span class="hd-dot">.</span></h2><p class="site-body">Start a new test and pick this site. You get a test link to send to anyone: they open it on their own computer, and you get the recording, transcript and summary back.</p></div><div><a class="btn g3 md" href={`/guides/${next.slug}`} data-glass-v3="secondary">{next.title}</a></div></div>
    ) : g.group === "test" ? (
      <div class="site-band w-test s-next"><div><span class="pill pill-review">Review</span><h2 class="site-h2">Then review it<span class="hd-dot">.</span></h2><p class="site-body">Open a session to read its summary and friction points, or watch the recording. With several sessions you can compare them.</p></div><div><a class="btn g3 md" href="/features#review" data-glass-v3="secondary">How review works</a></div></div>
    ) : null}
    <div class="s-tfaq"><h2 class="site-h2 s-h2">Questions<span class="hd-dot">.</span></h2><div class="s-faq-list">{g.faq!.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div></div>
    {related.length > 0 && <div class="s-rel"><h2 class="site-h3">Related guides</h2><div class="s-gcards"><Fragment set:html={related.map((r) => cardHtml(r!, true)).join("")} /></div></div>}
  </div></section>
  <section class="s-close-w"><div class="site-wrap"><div class="site-band w-hero s-close">
    <div><h2 class="site-h2">{g.cta}<span class="hd-dot">.</span></h2><p class="site-lead">Free to start. 3 test sessions with recordings included.</p></div>
    <div class="s-ctas"><a class="btn g3 md" href={signup} data-glass-v3="primary" data-fill="rgba(29,29,31,.8)"><span>Start free</span></a><a class="btn g3 md" href="/pricing" data-glass-v3="secondary"><span>See pricing</span></a></div></div>
  </div></section>
</SiteLayout>
