---
// Built from src/markup/home.html (layout and pictures) and src/data/copy/home.json (words). See docs/website/README.md.
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/website/home-page.css";
import { getPage } from "../lib/website";

const { html, copy, meta } = getPage("home");
---
<SiteLayout title={meta.title} description={meta.description} bodyClass={meta.bodyClass} jsonld={meta.jsonld} copy={copy} script="home">
  <Fragment set:html={html} />
</SiteLayout>
