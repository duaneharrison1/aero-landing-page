---
// Built from src/markup/how-findings-are-made.html (layout and pictures) and src/data/copy/how-findings-are-made.json (words). See docs/website/README.md.
import SiteLayout from "../../layouts/SiteLayout.astro";
import "../../styles/website/site-page.css";
import "../../styles/website/how-findings.css";
import { getPage } from "../../lib/website";

const { html, copy, meta } = getPage("how-findings-are-made");
---
<SiteLayout title={meta.title} description={meta.description} bodyClass={meta.bodyClass} jsonld={meta.jsonld} copy={copy} script="site">
  <Fragment set:html={html} />
</SiteLayout>
