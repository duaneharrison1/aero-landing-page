---
// Built from src/markup/pricing.html (layout) and src/data/copy/pricing.json (words). See docs/website/README.md.
// Plan prices: the markup holds the US prices (docs/brand/PRICING-FACTS.md); regional-pricing.js swaps in the
// visitor's regional price with the same logic as before (never change the currency or pricing logic).
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/website/site-page.css";
import { getPage } from "../lib/website";
import regionalPricing from "../scripts/website/regional-pricing.js?url";

const { html, copy, meta } = getPage("pricing");
---
<SiteLayout title={meta.title} description={meta.description} bodyClass={meta.bodyClass} jsonld={meta.jsonld} copy={copy} script="site">
  <Fragment set:html={html} />
  <script is:inline slot="scripts" src={regionalPricing}></script>
</SiteLayout>
