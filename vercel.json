{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/how-it-works",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pricing-test",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/features/analytics",
      "destination": "/features#publish",
      "permanent": true
    },
    {
      "source": "/features/code-conversion",
      "destination": "/features#publish",
      "permanent": true
    },
    {
      "source": "/features/custom-domain",
      "destination": "/features#publish",
      "permanent": true
    },
    {
      "source": "/features/custom-favicon",
      "destination": "/features#publish",
      "permanent": true
    },
    {
      "source": "/features/password-protection",
      "destination": "/features#publish",
      "permanent": true
    },
    {
      "source": "/features/project-showcase",
      "destination": "/features",
      "permanent": true
    },
    {
      "source": "/features/responsive-design",
      "destination": "/features#publish",
      "permanent": true
    },
    {
      "source": "/features/user-testing",
      "destination": "/features#test",
      "permanent": true
    },
    {
      "source": "/blog/user-testing-vs-maze",
      "destination": "/alternatives/maze/",
      "permanent": true
    },
    {
      "source": "/blog/Figmafolio-vs-Figma-Sites",
      "destination": "/alternatives/figma-sites/",
      "permanent": true
    }
  ]
}
